# ──────────────────────────────────────────────────────────────────────
# Voir — example environment file
# Copy to .env and edit. .env is gitignored.
# ──────────────────────────────────────────────────────────────────────

# ── Voir server (docker-compose reads this) ──────────────────────────

# Port the server listens on. Defaults to 9000.
PORT=9000

# Set to "production" for the built/serve path. Leave unset for dev.
# NODE_ENV=production

# ── Voice conversation mode (speech-to-text streaming) ────────────────

# Which STT backend /api/voice relays mic audio to.
#
#   mock     — no key needed. Detects speech by energy and emits
#              canned phrases as if transcribed, streamed word by
#              word. Enough to develop/demo the whole loop; used
#              by the docker compose dev stack.
#   deepgram — real streaming transcription (interim results, smart
#              formatting, provider VAD for turn-taking). Needs
#              VOICE_STT_API_KEY (free tier available).
#
# VOICE_STT_PROVIDER=mock
# VOICE_STT_MODEL=nova-2
# VOICE_STT_API_KEY=

# Neural narration (text-to-speech) uses the same Deepgram key by
# default (Aura-2 voices — see https://developers.deepgram.com/docs
# for the voice list). Override the voice, or force the browser's
# built-in speechSynthesis (the synthetic fallback), with:
#
# VOICE_TTS_PROVIDER=deepgram|browser   (default: deepgram if a key exists)
# VOICE_TTS_MODEL=aura-2-thalia-en

# Optional: enable verbose debug logging in the session manager.
# DEBUG=1

# ── Web Push notifications (docs/two-way.md) ──────────────────────────

# Generate once:  npx web-push generate-vapid-keys
# If unset, push is off: config reports { disabled: true }, the
# bell never appears, and /api/inbox still works (without pushes).
# VOIR_VAPID_PUBLIC_KEY=
# VOIR_VAPID_PRIVATE_KEY=

# Token machines present as `X-Voir-Token` against POST /api/inbox
# (cron/HA/curl starting conversations). If unset, the inbox
# endpoint returns 503 instead of accepting unauthenticated calls.
# VOIR_INBOX_TOKEN=

# Where voir keeps its own durable state (push subscription
# registry — push-subscriptions.json). Needs a PVC mount in k8s.
# VOIR_DATA_DIR=dev-data

# ── Estate observability (faro-recipe.md — App APM on Grafana) ───────

# Frontend telemetry, baked into the client bundle at build time (vite).
# The API key is a spam bar by design — it ships in the public bundle.
# Key value: ~/code/infra/keys/faro-api-key. Origins must pass the
# collector's exact-match CORS allowlist (faro-collector.yaml in the infra
# repo): https://chat.lab, http://localhost:9000 (dev server) and the
# devbox tailnet origins (100.x:9000, `tailscale serve` :8443) are
# allowed — see the infra repo for the exact entries.
#
# Unset/false → no faro, plain app.
# VITE_FARO_ENABLED=true
# VITE_FARO_URL=https://faro.stackunderflow.no/collect
# VITE_FARO_API_KEY=
#
# Backend traces are env-driven, not Vite: set
#   OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo.monitoring.svc.cluster.local:4318
#   OTEL_SERVICE_NAME=voir
# (k8s) or OTEL_EXPORTER_OTLP_ENDPOINT=http://100.66.57.52:30093 (devbox,
# tailnet NodePort — DEVBOX.md). Unset endpoint → tracing off. In dev the
# vite dev server has no span middleware — frontend-only telemetry there.
