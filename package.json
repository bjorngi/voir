{
  "name": "voir",
  "private": true,
  "type": "module",
  "description": "Chat interface for ACP-compatible coding agents — plus a pi package: the voir-rich extension (env-gated rich-content nudge) and skills documenting voir for agents.",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "extensions"
    ],
    "skills": [
      "skills"
    ]
  },
  "bin": {
    "acp-spawn": "./bin/acp-spawn.mjs",
    "voir-supervisor": "./bin/voir-supervisor.mjs"
  },
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "tsx bin/server.ts",
    "test": "node --import tsx --test test/**/*.test.ts",
    "typecheck": "react-router typegen && tsc"
  },
  "dependencies": {
    "@grafana/faro-web-sdk": "^2.13.0",
    "@grafana/faro-web-tracing": "^2.13.0",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/core": "^3.0.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
    "@opentelemetry/resources": "^3.0.0",
    "@opentelemetry/sdk-trace": "^3.0.0",
    "@react-router/express": "^8.5.0",
    "@react-router/node": "^8.5.0",
    "@react-router/serve": "^8.5.0",
    "express": "^5.1.0",
    "isbot": "^5.2.2",
    "mermaid": "^12.3.0",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router": "^8.5.1",
    "remark-gfm": "^4.0.1",
    "tsx": "^4.23.15",
    "uplot": "^1.6.32",
    "web-push": "^3.6.7",
    "ws": "8.22.1"
  },
  "devDependencies": {
    "@react-router/dev": "^8.5.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "8.18.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2",
    "vite": "^8.3.5",
    "vite-tsconfig-paths": "^6.1.1"
  }
}
